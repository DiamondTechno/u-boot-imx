 /dts-v1/;

 #include <dt-bindings/usb/pd.h>
 #include "imx91.dtsi"
 
 
 &ele_fw2 {
	 memory-region = <&ele_reserved>;
 };
 
 / {
	 model = "Diamond Technologies i.MX91 DEC SOM";
	 compatible = "dec,imx91-dec-kit", "fsl,imx91";

	 chosen {
		bootargs = "console=ttyLP0,115200";
		stdout-path = &lpuart1;
	};

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		linux,cma {
		   compatible = "shared-dma-pool";
		   reusable;
		   alloc-ranges = <0 0x80000000 0 0x10000000>;
		   size = <0 0x2000000>;
		   linux,cma-default;
	   };

		ele_reserved: ele-reserved@84120000 {
			compatible = "shared-dma-pool";
			reg = <0 0x84120000 0 0x100000>;
			no-map;
		};
	};
/*
	 usdhc3_pwrseq: usdhc3_pwrseq {
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_wifi_rst>;
		compatible = "mmc-pwrseq-simple";
		reset-gpios = <&gpio2 4 GPIO_ACTIVE_HIGH>,		// WL_RST 
					  <&gpio2 5 GPIO_ACTIVE_HIGH>;   	// BT_RST 
	};
*/	

	reg_usdhc3_vmmc: regulator-usdhc3 {
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_wifi_reg>;		
		compatible = "regulator-fixed";
		regulator-name = "WL_REG_ON";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		gpio = <&gpio2 6 GPIO_ACTIVE_HIGH>; /* WL_REG_ON connects to PDn signal on IW612 */
		/*
		 * IW612 wifi chip needs more delay than other wifi chips to complete
		 * the host interface initialization after power up, otherwise the
		 * internal state of IW612 may be unstable, resulting in the failure of
		 * the SDIO3.0 switch voltage.
		 */
		startup-delay-us = <20000>;
		enable-active-high;
	};

	reg_vref_1v8: regulator-adc-vref {
		compatible = "regulator-fixed";
		regulator-name = "vref_1v8";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
	};	
 };
	 
 
 &lpm {
	 soc-supply = <&buck1>;
	 status = "okay";
 };
 

 &lpi2c1 {
	#address-cells = <1>;
	#size-cells = <0>;
	clock-frequency = <400000>;
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&pinctrl_lpi2c1>;
	pinctrl-1 = <&pinctrl_lpi2c1>;
	status = "okay";

	/* eeprom on som */
	eeprom@50 {
		compatible = "atmel,24c02";
		reg = <0x50>;
		pagesize = <16>;		
	};

	rtc_i2c: rtc@51 {
		compatible = "microcrystal,rv3032";
		reg = <0x51>;
		interrupts = <7 IRQ_TYPE_LEVEL_LOW>;
		interrupt-parent = <&gpio2>;
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_rtc>;
	};

	pmic@25 {
		compatible = "nxp,pca9451a";
		reg = <0x25>;

		regulators {
			buck1: BUCK1 {
				regulator-name = "BUCK1";
				regulator-min-microvolt = <650000>;
				regulator-max-microvolt = <2237500>;
				regulator-boot-on;
				regulator-always-on;
				regulator-ramp-delay = <3125>;
			};

			buck2: BUCK2 {
				regulator-name = "BUCK2";
				regulator-min-microvolt = <600000>;
				regulator-max-microvolt = <2187500>;
				regulator-boot-on;
				regulator-always-on;
				regulator-ramp-delay = <3125>;
			};

			buck4: BUCK4{
				regulator-name = "BUCK4";
				regulator-min-microvolt = <600000>;
				regulator-max-microvolt = <3400000>;
				regulator-boot-on;
				regulator-always-on;
			};

			buck5: BUCK5{
				regulator-name = "BUCK5";
				regulator-min-microvolt = <600000>;
				regulator-max-microvolt = <3400000>;
				regulator-boot-on;
				regulator-always-on;
			};

			buck6: BUCK6 {
				regulator-name = "BUCK6";
				regulator-min-microvolt = <600000>;
				regulator-max-microvolt = <3400000>;
				regulator-boot-on;
				regulator-always-on;
			};

			ldo1: LDO1 {
				regulator-name = "LDO1";
				regulator-min-microvolt = <1600000>;
				regulator-max-microvolt = <3300000>;
				regulator-boot-on;
				regulator-always-on;
			};

			ldo4: LDO4 {
				regulator-name = "LDO4";
				regulator-min-microvolt = <800000>;
				regulator-max-microvolt = <3300000>;
				regulator-boot-on;
				regulator-always-on;
			};

			ldo5: LDO5 {
				regulator-name = "LDO5";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <3300000>;
				regulator-boot-on;
				regulator-always-on;
			};
		};
	};
 };
 
 
 &lpuart1 { /* console */
	 pinctrl-names = "default";
	 pinctrl-0 = <&pinctrl_uart1>;
	 status = "okay";
 };

 &lpuart5 { /* bluetooth */
	pinctrl-names = "default";
	assigned-clocks = <&clk IMX91_CLK_LPUART5>;
	assigned-clock-parents = <&clk IMX91_CLK_24M>;
	pinctrl-0 = <&pinctrl_uart5>;
	fsl,uart-has-rtscts;
	status = "okay";
};
 


 &usdhc1 {
	 pinctrl-names = "default", "state_100mhz", "state_200mhz";
	 pinctrl-0 = <&pinctrl_usdhc1>;
	 pinctrl-1 = <&pinctrl_usdhc1>;
	 pinctrl-2 = <&pinctrl_usdhc1>;
	 bus-width = <8>;
	 non-removable;
	 status = "okay";
 };

 &usdhc3 {
	pinctrl-names = "default", "state_100mhz", "state_200mhz";
	pinctrl-0 = <&pinctrl_usdhc3>;
	pinctrl-1 = <&pinctrl_usdhc3>;
	pinctrl-2 = <&pinctrl_usdhc3>;
	vmmc-supply = <&reg_usdhc3_vmmc>;
	bus-width = <4>;
	keep-power-in-suspend;
	non-removable;
	wakeup-source;
	no-1-8-v;
	status = "okay";
};
 
&usbotg1 {
	dr_mode = "otg";
	disable-over-current;
	samsung,picophy-pre-emp-curr-control = <3>;
	samsung,picophy-dc-vol-level-adjust = <7>;
	status = "okay";
};

&adc1 {
	vref-supply = <&reg_vref_1v8>;
	status = "disabled";
};

 &iomuxc {
 
	 pinctrl_lpi2c1: lpi2c1grp {
		fsl,pins = <
			MX91_PAD_I2C1_SCL__LPI2C1_SCL			0x40000b9e
			MX91_PAD_I2C1_SDA__LPI2C1_SDA			0x40000b9e
		>;
	 };
 
	 pinctrl_uart1: uart1grp {
		fsl,pins = <
			MX91_PAD_UART1_RXD__LPUART1_RX			0x31e
			MX91_PAD_UART1_TXD__LPUART1_TX			0x31e
		>;
	};

	pinctrl_uart5: uart5grp {
		fsl,pins = <
			MX91_PAD_GPIO_IO01__LPUART5_RX			0x31e
			MX91_PAD_GPIO_IO00__LPUART5_TX			0x31e
			MX91_PAD_GPIO_IO02__LPUART5_CTS_B		0x31e
			MX91_PAD_GPIO_IO03__LPUART5_RTS_B       0x31e
		>;
	};	

	pinctrl_usdhc1: usdhc1grp {
		 fsl,pins = <
			 MX91_PAD_SD1_CLK__USDHC1_CLK			0x159e
			 MX91_PAD_SD1_CMD__USDHC1_CMD			0x139e
			 MX91_PAD_SD1_DATA0__USDHC1_DATA0		0x139e
			 MX91_PAD_SD1_DATA1__USDHC1_DATA1		0x139e
			 MX91_PAD_SD1_DATA2__USDHC1_DATA2		0x139e
			 MX91_PAD_SD1_DATA3__USDHC1_DATA3		0x139e
			 MX91_PAD_SD1_DATA4__USDHC1_DATA4		0x139e
			 MX91_PAD_SD1_DATA5__USDHC1_DATA5		0x139e
			 MX91_PAD_SD1_DATA6__USDHC1_DATA6		0x139e
			 MX91_PAD_SD1_DATA7__USDHC1_DATA7		0x139e
			 MX91_PAD_SD1_STROBE__USDHC1_STROBE		0x159e
		 >;
	 };
  
	pinctrl_usdhc3: usdhc3grp {
		fsl,pins = <
			MX91_PAD_SD3_CLK__USDHC3_CLK			0x15fe
			MX91_PAD_SD3_CMD__USDHC3_CMD			0x13fe
			MX91_PAD_SD3_DATA0__USDHC3_DATA0		0x13fe
			MX91_PAD_SD3_DATA1__USDHC3_DATA1        0x13fe
			MX91_PAD_SD3_DATA2__USDHC3_DATA2        0x13fe
			MX91_PAD_SD3_DATA3__USDHC3_DATA3        0x13fe
		>;
	};
	
	pinctrl_rtc: rtcgrp {
		fsl,pins = <
			MX91_PAD_GPIO_IO07__GPIO2_IO7			0x31e /* RTC_nINT */
		>;
	 };

	pinctrl_wifi_reg: wifireggrp {
		fsl,pins = <
			MX91_PAD_GPIO_IO06__GPIO2_IO6			0x31e /* WL_REG_ON */
		>;
	};

	pinctrl_wifi_rst: wifirstgrp {
		fsl,pins = <
			MX91_PAD_GPIO_IO04__GPIO2_IO4			0x31e /* WL_RST */
			MX91_PAD_GPIO_IO05__GPIO2_IO5			0x31e /* BT_RST */
		>;
	};
 };

 